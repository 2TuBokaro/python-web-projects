# Vercel
.vercel/

# Keep important files
!api/requirements.txt
!vercel.json
!.vercelignore
!README.md

# Allow root-level files for Vercel
!index.html
!styles.css
!app.js
!auth.js
!data-layer.js
!config/
!assets/
!public/

# Exclude large assets but keep essential small files
assets/*
!assets/logo.jpg
!assets/MainYouTubeImageFinalInJPEG.jpg
!assets/Red Green Minimalist Medical Logo.gif
!assets/doctor-nurses-special-equipment.jpg
!assets/MMpromoTextInEng.txt
!assets/MMpromotextInHindi.txt
!assets/CurrentObjective.txt
!assets/README.md

# Exclude subdirectories with large files
assets/Data/
assets/Meta/
assets/Stickers/
assets/WhatsApp*/

# Keep public assets
public/

# Exclude everything in frontend and public except specific files
frontend/*
!frontend/index.html
!frontend/login.html
!frontend/styles.css
!frontend/app.js
!frontend/auth.js
!frontend/data-layer.js
!frontend/admin-dashboard.js
!frontend/public-dashboard.js
!frontend/staff-dashboard.js
!frontend/notification-system.js
!frontend/config/
!frontend/utils/

public/*
!public/index.html
!public/login.html
!public/styles.css
!public/app.js
!public/auth.js
!public/data-layer.js
!public/admin-dashboard.js
!public/public-dashboard.js
!public/staff-dashboard.js
!public/notification-system.js
!public/config/
!public/utils/

# Exclude static directory entirely
static/

# Exclude zip file
*.zip